# FreeWili OG room node -- ESP32-C6 (Bottlenose Orca) network side.
#
# Console on USB Serial/JTAG on purpose: UART0 (GPIO16/17) is the 3 Mbaud link
# to the main CPU, and log output there would corrupt the JSON protocol.
CONFIG_IDF_TARGET="esp32c6"

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

CONFIG_ESP_WIFI_CSI_ENABLED=n
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
